# --- TRADING AGENT (CONECTORES API REST) ---
# Soporte IP Binding directo (Sin Passphrase)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here

BITSO_API_KEY=your_bitso_api_key_here
BITSO_SECRET_KEY=your_bitso_secret_key_here

# --- CONTENT METRICS AGENT (MÉTRICAS SOCIALES) ---
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# --- DEVOPS & GIT ORCHESTRATION ---
GIT_REPO_PATH=E:\TOKYOAPPS_UNIVERSE\01_ACTIVE\NULOGIC_CORE
GITHUB_TOKEN=your_github_personal_access_token_here

# --- NOTIFICATIONS & ALERTS ---
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
